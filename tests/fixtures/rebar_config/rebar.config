%% Build config for the Saltmere berth service.
{minimum_otp_vsn, "26"}.
{erl_opts, [debug_info]}.
{deps, [
    {cowboy, "2.12.0"},
    {jsx, {git, "https://github.com/talentdeficit/jsx.git", {tag, "v3.1.0"}}},
    recon
]}.
{plugins, [rebar3_hex]}.
{relx, [{release, {berths, "1.4.0"}, [berths, sasl]}]}.
