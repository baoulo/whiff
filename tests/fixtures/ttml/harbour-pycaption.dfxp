<?xml version="1.0" encoding="utf-8"?>
<tt xml:lang="en" xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
 <head>
  <styling>
   <style tts:color="white" tts:fontFamily="monospace" tts:fontSize="1c" xml:id="default"/>
  </styling>
  <layout>
   <region tts:displayAlign="after" tts:textAlign="center" xml:id="bottom"/>
  </layout>
 </head>
 <body>
  <div region="bottom" xml:lang="en-US">
   <p begin="00:00:00.500" end="00:00:03.000" region="bottom" style="default">
    Morning on the Saltmere breakwater.
   </p>
   <p begin="00:00:03.200" end="00:00:05.800" region="bottom" style="default">
    The ferry leaves at seven,<br/>
    as it has for forty years.
   </p>
   <p begin="00:00:06.000" end="00:00:08.000" region="bottom" style="default">
    [gulls calling]
   </p>
   <p begin="00:00:08.200" end="00:00:11.000" region="bottom" style="default">
    Tide's turning. We should check<br/>
    the mooring buoys.
   </p>
   <p begin="00:00:11.200" end="00:00:14.000" region="bottom" style="default">
    The lighthouse keeper logs<br/>
    every boat that passes.
   </p>
   <p begin="00:00:14.200" end="00:00:16.500" region="bottom" style="default">
    ♪ brass band playing ♪
   </p>
   <p begin="00:00:16.800" end="00:00:19.500" region="bottom" style="default">
    Harbour office, this is the pilot launch.
   </p>
   <p begin="00:00:19.700" end="00:00:22.000" region="bottom" style="default">
    Fog rolls in from the outer mole by noon.
   </p>
   <p begin="00:00:22.200" end="00:00:25.000" region="bottom" style="default">
    Keep to the marked channel<br/>
    past the red buoy.
   </p>
   <p begin="00:00:25.200" end="00:00:28.000" region="bottom" style="default">
    By evening the quay is quiet again.
   </p>
  </div>
 </body>
</tt>
