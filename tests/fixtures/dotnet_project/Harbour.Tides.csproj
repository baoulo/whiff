<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Saltmere.Tides</RootNamespace>
    <PackageId>Saltmere.Tides</PackageId>
    <Version>1.4.0</Version>
    <Authors>Harbour Office</Authors>
    <Description>Tide predictions for Saltmere Harbour.</Description>
    <PackageLicenseExpression>CC0-1.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Serilog">
      <Version>4.0.2</Version>
    </PackageReference>
    <ProjectReference Include="..\Harbour.Model\Harbour.Model.csproj" />
  </ItemGroup>

  <Target Name="PrintVersion" AfterTargets="Build">
    <Exec Command="echo $(Version)" />
  </Target>

</Project>
